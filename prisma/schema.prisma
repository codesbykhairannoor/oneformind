generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  explorer
  architect
  quantum
  legendary
  trial
}

model User {
  id                      Int       @id @default(autoincrement())
  name                    String
  email                   String    @unique
  username                String?   @unique
  password                String?
  googleId                String?   @map("google_id")
  emailVerified           DateTime? @map("email_verified_at")
  
  // Profile settings
  settings                Json?
  image                   String?   @map("avatar_path")
  timezone                String?   @default("UTC")
  cookieConsent           String?   @map("cookie_consent")
  
  // Subscription & Plans
  isPremium               Boolean   @default(false) @map("is_premium")
  planType                String    @default("explorer") @map("plan_type")
  premiumUntil            DateTime? @map("premium_until")
  hasUsedTrial            Boolean   @default(false) @map("has_used_trial")
  
  // Extended features
  resumeText              String?   @map("resume_text")
  resumeFilename          String?   @map("resume_filename")
  notificationPreferences Json?     @map("notification_preferences")
  onboardingCompleted     Boolean   @default(false) @map("onboarding_completed")
  onboardingData          Json?     @map("onboarding_data")

  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @default(now()) @map("updated_at")

  accounts                Account[]
  sessions                Session[]
  habits                  Habit[]
  financeBudgets          FinanceBudget[]
  financeCategories       FinanceCategory[]
  financeSavings          FinanceSaving[]
  financeTransactions     FinanceTransaction[]
  plannerTasks            PlannerTask[]
  jobs                    Job[]
  goals                   Goal[]
  goalContributions       GoalContribution[]
  journals                Journal[]
  calendarEvents          CalendarEvent[]
  studyCourses            StudyCourse[]
  plannerDailies          PlannerDaily[]
  financeAssets           FinanceAsset[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Habit {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  period          String
  name            String
  icon            String?
  color           String
  monthlyTarget   Int        @map("monthly_target") @db.SmallInt
  isArchived      Boolean    @default(false) @map("is_archived")
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")
  status          String     @default("active")
  position        Int        @default(0)

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            HabitLog[]

  @@map("habits")
}

model HabitLog {
  id              Int        @id @default(autoincrement())
  habitId         Int        @map("habit_id")
  date            DateTime   @db.Date
  status          String
  notes           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  habit           Habit      @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model FinanceBudget {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  category        String
  limitAmount     Decimal    @map("limit_amount") @db.Decimal
  month           String
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_budgets")
}

model FinanceCategory {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  name            String
  slug            String
  type            String
  icon            String
  color           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_categories")
}

model FinanceSaving {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  title           String
  targetAmount    Decimal    @map("target_amount") @db.Decimal
  currentAmount   Decimal    @map("current_amount") @db.Decimal
  icon            String?
  color           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_savings")
}

model FinanceTransaction {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  title           String
  amount          Decimal    @db.Decimal
  type            String
  category        String
  date            DateTime   @db.Date
  notes           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_transactions")
}

model PlannerTask {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  date            DateTime   @db.Date
  startTime       DateTime?  @map("start_time") @db.Time
  endTime         DateTime?  @map("end_time") @db.Time
  title           String
  notes           String?
  type            Int        @db.SmallInt
  isCompleted     Boolean    @map("is_completed")
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("planner_tasks")
}

model Job {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  title           String
  company         String
  status          String
  salary          Decimal?   @db.Decimal
  notes           String?
  appliedDate     DateTime?  @map("applied_date") @db.Date
  location        String?
  jobUrl          String?    @map("job_url")
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jobs")
}

model Goal {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  title           String
  category        String?
  type            String
  targetValue     Decimal    @map("target_value") @db.Decimal
  currentValue    Decimal    @map("current_value") @db.Decimal
  startDate       DateTime?  @map("start_date") @db.Date
  endDate         DateTime?  @map("end_date") @db.Date
  specificDays    Json?      @map("specific_days")
  status          String
  coverImageUrl   String?    @map("cover_image_url")
  reward          String?
  priority        String     @default("medium")
  coverImagePath  String?    @map("cover_image_path")
  color           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones      GoalMilestone[]
  contributions   GoalContribution[]

  @@map("goals")
}

model GoalMilestone {
  id              Int        @id @default(autoincrement())
  goalId          Int        @map("goal_id")
  title           String
  completed       Boolean    @default(false)
  order           Int        @default(0)
  targetDate      DateTime?  @map("target_date") @db.Date
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  goal            Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_milestones")
}

model GoalContribution {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  goalId          Int        @map("goal_id")
  chainRuleId     Int?       @map("chain_rule_id")
  sourceType      String     @map("source_type")
  sourceId        Int        @map("source_id")
  eventRef        String     @map("event_ref")
  valueDelta      Decimal    @map("value_delta") @db.Decimal
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_contributions")
}

model Journal {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  date            DateTime   @db.Date
  title           String?
  content         String?
  mood            String?
  imagePath       String?    @map("image_path")
  isPinned        Boolean    @default(false) @map("is_pinned")
  aiSentiment     String?    @map("ai_sentiment")
  moodScore       Int?       @map("mood_score")
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journals")
}

model CalendarEvent {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  title           String
  description     String?
  type            String
  color           String
  startDate       DateTime   @map("start_date") @db.Date
  endDate         DateTime?  @map("end_date") @db.Date
  isAllDay        Boolean    @default(false) @map("is_all_day")
  startTime       DateTime?  @map("start_time") @db.Time
  endTime         DateTime?  @map("end_time") @db.Time
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

model StudyCourse {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  courseName      String          @map("course_name")
  semester        Int
  sks             Int
  grade           String?
  archives        StudyArchive[]
  createdAt       DateTime?       @default(now()) @map("created_at")
  updatedAt       DateTime?       @default(now()) @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_courses")
}

model StudyArchive {
  id              String          @id @default(cuid())
  courseId        Int             @map("course_id")
  meetingTag      String          @map("meeting_tag")
  type            String
  fileName        String?         @map("file_name")
  filePath        String?         @map("file_path")
  linkUrl         String?         @map("link_url")
  createdAt       DateTime?       @default(now()) @map("created_at")
  updatedAt       DateTime?       @default(now()) @updatedAt @map("updated_at")

  course          StudyCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("study_archives")
}

model PlannerDaily {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  date            DateTime   @db.Date
  notes           String?
  meals           Json?
  waterGlasses    Int        @default(0) @map("water_glasses")
  inbox           Json?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("planner_daily")
}

model FinanceAsset {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  name            String
  value           Decimal    @db.Decimal
  icon            String?
  color           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_assets")
}
