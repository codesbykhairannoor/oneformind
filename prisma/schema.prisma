generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  explorer
  architect
  quantum
  legendary
  trial
}

model User {
  id                      Int       @id @default(autoincrement())
  name                    String
  email                   String    @unique
  username                String?   @unique
  password                String?
  googleId                String?   @map("google_id")
  emailVerified           DateTime? @map("email_verified_at")
  
  // Profile settings
  settings                Json?
  image                   String?   @map("avatar_path")
  timezone                String?   @default("UTC")
  cookieConsent           String?   @map("cookie_consent")
  
  // Subscription & Plans
  isPremium               Boolean   @default(false) @map("is_premium")
  planType                String    @default("explorer") @map("plan_type")
  premiumUntil            DateTime? @map("premium_until")
  hasUsedTrial            Boolean   @default(false) @map("has_used_trial")
  
  // Extended features
  resumeText              String?   @map("resume_text")
  resumeFilename          String?   @map("resume_filename")
  notificationPreferences Json?     @map("notification_preferences")
  onboardingCompleted     Boolean   @default(false) @map("onboarding_completed")
  onboardingData          Json?     @map("onboarding_data")

  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @default(now()) @map("updated_at")

  accounts                Account[]
  sessions                Session[]
  habits                  Habit[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Habit {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  period          String
  name            String
  icon            String?
  color           String
  monthlyTarget   Int        @map("monthly_target") @db.SmallInt
  isArchived      Boolean    @default(false) @map("is_archived")
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")
  status          String     @default("active")
  position        Int        @default(0)

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            HabitLog[]

  @@map("habits")
}

model HabitLog {
  id              Int        @id @default(autoincrement())
  habitId         Int        @map("habit_id")
  date            DateTime   @db.Date
  status          String
  notes           String?
  createdAt       DateTime?  @default(now()) @map("created_at")
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at")

  habit           Habit      @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}
